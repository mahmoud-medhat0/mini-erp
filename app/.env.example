# Historical Next.js reference only. Active deployment uses laravel/.env.example.
# Copy to .env and fill locally only. Never commit real secrets.
DATABASE_URL=
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Queue (pg-boss uses DATABASE_URL by default; set separately if using a dedicated DB)
PGBOSS_DATABASE_URL=
BASE_CURRENCY="EGP"
NODE_ENV="development"
