# Copy to .env and fill. Never commit real secrets.
DATABASE_URL="postgresql://erp:erp@localhost:5432/mini_erp?schema=public"
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"
# Queue (pg-boss uses DATABASE_URL by default; set separately if using a dedicated DB)
PGBOSS_DATABASE_URL=""
BASE_CURRENCY="EGP"
NODE_ENV="development"
