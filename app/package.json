{
  "name": "mini-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "vitest run tests/invariants",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "ci": "npm run typecheck && npm run lint && npm run test:invariants && npm run test"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-intl": "^3.20.0",
    "next-auth": "^5.0.0-beta.20",
    "@prisma/client": "^5.20.0",
    "zod": "^3.23.8",
    "decimal.js": "^10.4.3",
    "pg-boss": "^10.1.5",
    "argon2": "^0.41.1",
    "@tanstack/react-table": "^8.20.5",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.47.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.45",
    "autoprefixer": "^10.4.20"
  }
}
